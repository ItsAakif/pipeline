# Backend API base URL (read at build time; rebuild after changing it).
#
# Leave UNSET for a same-origin deploy (single container): the backend serves
# the SPA and the API from the same host, so the app defaults to the relative
# path "/api". The Vite dev server also proxies "/api" to http://localhost:8080.
#
# Set an ABSOLUTE URL for a split deploy (frontend on a static host/CDN,
# backend elsewhere), for example:
#   VITE_API_BASE_URL=https://your-backend.onrender.com/api
# VITE_API_BASE_URL=

# WebSocket base URL (for future use; the current UI does not consume it).
# Leave unset for same-origin: derive it from window.location at runtime
# (e.g. `${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/ws`).
# Set an absolute ws:// or wss:// URL only for a split deploy.
# VITE_WS_BASE_URL=
